# Copy this file to ".env.local" and fill in your own values.
# NEVER commit .env.local — it is already listed in .gitignore.

# Supabase → Project Settings → Data API (or "API") → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
# On older projects use the "anon public" key instead. Both are safe in the browser
# ONLY because Row Level Security is enabled on every table.
# NEVER put the "secret" / "service_role" key here or anywhere in this project.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Your live website address, without a trailing slash. Leave empty until you deploy.
# Example: https://swat-kings-cricket-academy.pages.dev
VITE_SITE_URL=
